# FraudGuard environment template. Copy to .env locally and fill secrets.

APP_ENV=render
FRAUD_MODEL_MODE=transaction_candidate
AUTH_REQUIRED=true
FRAUDGUARD_API_KEY=
PUBLIC_BASE_URL=
PORT=8000

TRANSACTION_CANDIDATE_ARTIFACT_ROOT=artifacts/benchmark/transaction_data/candidate
TRANSACTION_ARTIFACT_RELEASE_ID=tx-YYYYMMDD-001
ARTIFACT_STORAGE_BUCKET=fraudguard-model-releases
ARTIFACT_CACHE_ROOT=/app/runtime/model-releases
ARTIFACT_DOWNLOAD_TIMEOUT_SECONDS=20
ARTIFACT_DOWNLOAD_RETRIES=2
ROLLBACK_RELEASE_ID=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_FAIL_CLOSED=false
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

MAX_REQUEST_BYTES=1048576
MAX_BATCH_ROWS=100
DISABLE_PREDICTION_PERSISTENCE=false

# Frontend
VITE_API_URL=http://localhost:8000
