# Local defaults. Provider secrets are optional for local startup.
APP_ENV=local
PORT=8000

# Local artifact directory or immutable remote release selection.
TRANSACTION_ARTIFACT_ROOT=artifacts/benchmark/transaction_data/model
TRANSACTION_ARTIFACT_RELEASE_ID=
ARTIFACT_STORAGE_BUCKET=fraudguard-model-releases
ARTIFACT_CACHE_ROOT=artifacts/releases
ARTIFACT_DOWNLOAD_TIMEOUT_SECONDS=20
ARTIFACT_DOWNLOAD_RETRIES=2

# Server-only Supabase credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Upstash credentials. Missing values use local in-memory limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_FAIL_CLOSED=false
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

MAX_REQUEST_BYTES=1048576
MAX_BATCH_ROWS=100
DASHBOARD_RETENTION_DAYS=30
DASHBOARD_ROW_LIMIT=10000

# Frontend development only. Leave blank for same-origin production.
VITE_API_URL=http://localhost:8000
